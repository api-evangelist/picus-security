        {
          "id": "be4b1556-4301-4e98-8731-b617642ba555",
          "name": "# Getting access token for endpoints",
          "request": {
            "name": "# Getting access token for endpoints",
            "description": {
              "content": "OAuth2 protocol is used to authorize Refresh/Access tokens.\nTo obtain the API, you should generate a refresh token and then request an access token using the /v1/auth/token endpoint.\nThe refresh token will be valid for 6 months, whereas the access token will be available for 2 hours.\nAfter getting the access token, add Authorization: Bearer {accessToken} to the header to request access to the below endpoints.",
              "type": "text/plain"
            },
            "url": {
              "protocol": "https",
              "path": [
                "",
                "v1",
                "auth",
                "token"
              ],
              "host": [
                "api",
                "picussecurity",
                "com"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
