{
  "opencollection": "1.0.0",
  "info": {
    "name": "Picus Customer Users API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "# Get Users",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.picussecurity.com/v1/users",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query"
              },
              {
                "name": "role",
                "value": "",
                "type": "query",
                "description": "Role"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "User; Email, User ID, Assigned Role, Role ID, Name, Surname, IsActive Status."
        },
        {
          "info": {
            "name": "# Invite User",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.picussecurity.com/v1/users/invite",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Invite User; Email, Role ID, Login Type"
        },
        {
          "info": {
            "name": "# Get Roles",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.picussecurity.com/v1/users/roles",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Roles; Role ID, Role Name"
        },
        {
          "info": {
            "name": "# Delete User",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.picussecurity.com/v1/users/:userId",
            "params": [
              {
                "name": "userId",
                "value": "12345",
                "type": "path",
                "description": "User ID to delete"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Delete User; User ID, Success Status"
        },
        {
          "info": {
            "name": "# Assign Role",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.picussecurity.com/v1/users/:userId/role",
            "params": [
              {
                "name": "userId",
                "value": "12345",
                "type": "path",
                "description": "User ID whose role will be updated"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Assign Role; User ID, Role ID"
        }
      ]
    }
  ],
  "bundled": true
}