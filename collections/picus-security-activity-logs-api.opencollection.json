{
  "opencollection": "1.0.0",
  "info": {
    "name": "Picus Customer Activity Logs API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Activity-Logs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "# Get activity logs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.picussecurity.com/v1/activity-logs",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query"
              },
              {
                "name": "date_start",
                "value": "",
                "type": "query",
                "description": "Date start in epoch"
              },
              {
                "name": "date_end",
                "value": "",
                "type": "query",
                "description": "Date end in epoch"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "This endpoint return activity logs."
        }
      ]
    }
  ],
  "bundled": true
}